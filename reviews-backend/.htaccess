# Hardening for the reviews-backend folder on Apache (Hostinger's default
# web server). Blocks direct browser access to anything that isn't meant to
# be public — config, SQL, and shared PHP includes.

# Never serve config.php, config.sample.php, or any .sql file directly.
<FilesMatch "(^config\.php$|^config\.sample\.php$|\.sql$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# includes/ and sql/ contain shared code and schema only — nothing in
# them should ever be requested directly by a browser.
RewriteEngine On
RewriteRule ^(includes|sql)/ - [F,L]

Options -Indexes
