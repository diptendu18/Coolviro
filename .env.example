# =============================================================================
# Coolviro Services — Environment Variables
# Copy this file to .env.local for local development (never commit .env.local)
# =============================================================================

# ---------------------------------------------------------------------------
# BOOKING EMAIL NOTIFICATIONS
# ---------------------------------------------------------------------------
# Destination address for booking form submissions. This is NOT a secret,
# but it is only ever read on the server (pages/api/booking.js) and is never
# sent to the browser or displayed on the website.
EMAIL_TO=suvojitroy188@gmail.com

# SMTP credentials used by the server-side API route (pages/api/booking.js)
# to send the booking notification email via Nodemailer. Works with Gmail
# (using an App Password), or any transactional email provider that offers
# SMTP (SendGrid, Mailgun, Amazon SES, Postmark, Zoho Mail, etc).
#
# If these are left unset, the booking API runs in DEVELOPMENT MODE: the
# booking details are logged to the server console instead of emailed, so
# you can test the full booking flow locally before you have real email
# credentials. See README.md "Booking Email Setup" for full instructions.
SMTP_HOST=[NEEDS USER INPUT]
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=[NEEDS USER INPUT]
SMTP_PASS=[NEEDS USER INPUT]

# Optional: "From" display name/address used on outgoing emails.
# If unset, SMTP_USER is used.
EMAIL_FROM=[NEEDS USER INPUT]

# ---------------------------------------------------------------------------
# PRODUCTION DOMAIN
# ---------------------------------------------------------------------------
# Used to generate canonical URLs, Open Graph URLs, sitemap.xml and
# robots.txt. Set this once a domain is purchased and connected.
SITE_URL=[NEEDS USER INPUT: PRODUCTION DOMAIN]

# ---------------------------------------------------------------------------
# GOOGLE ANALYTICS (GA4)
# ---------------------------------------------------------------------------
# The GA4 script only loads when this is set to a real Measurement ID
# (format: G-XXXXXXXXXX). Leave unset to keep Analytics disabled.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=[NEEDS USER INPUT]

# ---------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE
# ---------------------------------------------------------------------------
# HTML tag verification code (the "content" value only, not the full tag).
# Only rendered in <head> when set.
NEXT_PUBLIC_GSC_VERIFICATION=[NEEDS USER INPUT]
